# Copy to .env and fill in. Never commit .env.

# --- LLM provider (pick one or more) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# --- Optional: observability ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# --- Override defaults if you want ---
