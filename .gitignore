# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.eggs/
.python-version

# Virtual envs
.venv/
venv/
env/

# uv
.uv/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.hypothesis/

# Type checking
.mypy_cache/
.ruff_cache/
.pyre/

# IDEs
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Project data — never commit these
data/pdfs/
data/lancedb/
data/*.jsonl
data/*.pkl
data/*.parquet
!data/.gitkeep

# Eval runs: ignore per-query traces (large, reproducible) but commit small
# generation-eval aggregates. To use a negation under a directory, the directory
# itself must NOT be ignored — match files within it instead.
evals/runs/*.jsonl
evals/runs/*.json
# Exceptions: small generation-eval artifacts back the README ablation numbers
!evals/runs/generation_*.json
!evals/runs/generation_*.jsonl
!evals/.gitkeep

# Secrets
.env
.env.local
*.key

# Logs
*.log
logs/

# Model caches
.cache/
models/
